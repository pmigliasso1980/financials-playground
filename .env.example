# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# SEC EDGAR
# ---------------------------------------------------------------------------

# MANDATORY for harvesting. It is not a credential: EDGAR is public and free,
# there is no account and no API key. SEC requires every automated client to
# identify itself with a name and email in the User-Agent header, so they can
# warn you if your script misbehaves rather than blocking the whole IP range.
# Without it they return 403.
#
# Format: a name and a real email, separated by a space.
SEC_USER_AGENT="Your Name you@email.com"

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

# Optional. Defaults to the docker-compose instance on port 5433, which is
# what `npm run db:up` starts.
# DATABASE_URL=postgres://financials:financials@localhost:5433/financials
