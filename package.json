{
  "name": "financials-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A corpus of conduit CMBS loans built from public SEC EDGAR filings, with the tools to interrogate it and to try to prove it wrong.",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:analyze": "tsx db/analyze.ts",
    "db:benchmark": "tsx db/benchmark.ts",
    "db:bias": "tsx analysis/bias.ts",
    "db:challenge": "tsx analysis/challenge.ts",
    "db:cohort": "tsx analysis/cohort.ts",
    "db:composition": "tsx analysis/composition.ts",
    "db:composition-signal": "tsx analysis/compositionSignal.ts",
    "db:coverage": "tsx db/coverage.ts",
    "db:delinquency": "tsx db/delinquency.ts",
    "db:down": "docker compose down",
    "db:explain": "tsx db/explain.ts",
    "db:identities": "tsx db/identities.ts",
    "db:join": "tsx db/servicerJoin.ts",
    "db:mechanism": "tsx analysis/mechanism.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:outcomes": "tsx analysis/outcomes.ts",
    "db:page": "tsx db/page.ts",
    "db:performance": "tsx db/servicerBatch.ts",
    "db:power": "tsx analysis/power.ts",
    "db:predictors": "tsx analysis/predictors.ts",
    "db:reset": "tsx db/migrate.ts --reset",
    "db:seller": "tsx analysis/sellerEffect.ts",
    "db:servicer-effect": "tsx analysis/servicerEffect.ts",
    "db:snapshot": "tsx db/snapshot.ts",
    "db:stability": "tsx analysis/stability.ts",
    "db:stats": "tsx db/stats.ts",
    "db:status": "tsx db/migrate.ts --status",
    "db:test": "tsx db/conformance.test.ts",
    "db:up": "docker compose up -d",
    "harvest": "tsx harvest/cli.ts",
    "harvest:batch": "tsx harvest/batch.ts",
    "harvest:capture": "tsx harvest/capture.ts",
    "harvest:diagnose": "tsx harvest/diagnose.ts",
    "harvest:env:test": "tsx harvest/env.test.ts",
    "harvest:fixtures": "tsx harvest/fixtures.test.ts",
    "harvest:history": "tsx harvest/historyProbe.ts",
    "harvest:inspect": "tsx harvest/inspect.ts",
    "harvest:occupancy": "tsx harvest/occupancyProbe.ts",
    "harvest:real": "tsx harvest/real.test.ts",
    "harvest:scale": "tsx harvest/scale.test.ts",
    "harvest:seller": "tsx harvest/sellerProbe.ts",
    "harvest:servicer": "tsx harvest/servicerProbe.ts",
    "harvest:servicer:test": "tsx harvest/servicer.test.ts",
    "harvest:test": "tsx harvest/test.ts",
    "harvest:ties": "tsx harvest/tieProbe.ts",
    "taxonomy": "tsx harvest/taxonomy.ts",
    "test:all": "npm run typecheck && npm run harvest:env:test && npm run harvest:test && npm run harvest:real && npm run harvest:scale && npm run harvest:fixtures && npm run harvest:servicer:test",
    "typecheck": "tsc --noEmit",
    "db:catalog": "tsx db/catalog.ts",
    "db:type-gap": "tsx db/typeGap.ts",
    "api": "tsx api/server.ts",
    "api:smoke": "tsx api/smoke.ts",
    "db:monitor": "tsx db/monitor.ts",
    "mcp": "tsx mcp/server.ts",
    "db:fix-states": "tsx db/fixStates.ts",
    "db:missing-state": "tsx db/missingState.ts",
    "db:provenance": "tsx db/provenanceCli.ts",
    "api:scenarios": "tsx api/scenarios.ts",
    "api:contract": "python3 tools/check-html-contract.py",
    "check:spanish": "python3 tools/find-spanish.py && python3 tools/find-spanish-idents.py",
    "check:sql": "python3 tools/check-sql.py",
    "check:all": "npm run typecheck && npm run check:spanish && npm run check:sql && npm run check:query-types && npm run check:agree && npm run api:contract",
    "check:agree": "python3 tools/agree.py",
    "check:query-types": "python3 tools/check-query-types.py",
    "check:ratchet": "python3 tools/ratchet.py",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "node-html-parser": "^6.1.13",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "openapi-typescript": "^7.4.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
