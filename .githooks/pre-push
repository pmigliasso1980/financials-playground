#!/bin/sh
#
# The gate this project learned it needed, at a strength it can actually run at.
#
# The migration to English was closed file by file against find-spanish.py,
# which works on prose and cannot see a Spanish identifier: one word on a line
# of English code never reaches its two-word threshold. Files were committed as
# translated with ~1,100 Spanish identifiers still in them, and nothing said
# otherwise, because the only thing being asked was a tool that could not fail.
#
# First version of this hook demanded zero and blocked every push, since the
# migration is not finished. A gate that cannot go green until a multi-day job
# ends is a gate people pass --no-verify to forever. So the Spanish counts are
# ratcheted: they may fall, never rise. tsc and the SQL/contract checks are
# absolute, because those are already green.
#
# Install with: npm run hooks:install
# Bypass with:  git push --no-verify   (when you mean to, and know why)

set -e

echo "pre-push: typecheck"
npx tsc --noEmit

echo "pre-push: SQL syntax"
python3 tools/check-sql.py > /dev/null

echo "pre-push: HTML/API contract"
python3 tools/check-html-contract.py > /dev/null

echo "pre-push: Spanish (ratcheted — may fall, never rise)"
python3 tools/ratchet.py

echo "pre-push: ok"
