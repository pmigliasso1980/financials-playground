# Copiar a .env y completar. .env está gitignored.

# API key de Lev. Se crea en app.lev.com → Settings → API Keys (requiere ser workspace admin).
# El valor completo se muestra UNA SOLA VEZ al crearla.
# Prefijo esperado: lev_sk_
LEV_API_KEY=

# Base URL de la API. No debería cambiar.
LEV_API_BASE=https://api.lev.com/api/external/v2

# Identifica tu app en los logs y analytics de Lev. Header obligatorio en toda request.
LEV_ORIGIN_APP=financials-playground

# Solo para usuarios JWT que pertenecen a más de una cuenta.
# Las API keys IGNORAN este header (están atadas a una cuenta al emitirse).
# LEV_ACTIVE_ACCOUNT=mi-cuenta-slug

# ---------------------------------------------------------------------------
# SEC EDGAR
# ---------------------------------------------------------------------------

# OBLIGATORIO para cosechar. No es una credencial: EDGAR es público y gratis,
# no hay cuenta ni API key. La SEC exige que todo cliente automatizado se
# identifique con nombre y email en el header User-Agent, para poder avisarte
# si tu script se descontrola en vez de bloquear el rango de IPs entero.
# Sin esto devuelven 403.
#
# Formato: nombre y un email real, separados por espacio.
SEC_USER_AGENT="Tu Nombre tu@email.com"
